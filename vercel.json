{
  "version": 2,
  "builds": [
    {
      "src": "smart_parking/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "smart_parking/wsgi.py"
    }
  ],
  "crons": [
    {
      "path": "/api/process-tasks/",
      "schedule": "0 0 * * *"
    }
  ]
}
