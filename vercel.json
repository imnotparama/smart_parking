{
  "version": 2,
  "builds": [
    {
      "src": "smart_parking/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "smart_parking/wsgi.py"
    }
  ],
  "crons": [
    {
      "path": "/api/process-tasks/",
      "schedule": "*/10 * * * *"
    }
  ]
}
