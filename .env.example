# ============================================================
# .env.example — Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ============================================================

# Django Core
SECRET_KEY=your-50-character-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app.vercel.app,localhost,127.0.0.1

# Database (Neon PostgreSQL)
# Get this from your Neon project dashboard → Connection String
DATABASE_URL=postgres://user:password@your-neon-host.neon.tech/dbname?sslmode=require

# Email (Gmail SMTP — use an App Password, not your real password)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-digit-app-password

# Vercel Cron Secret (any random string — set the same in Vercel dashboard)
CRON_SECRET=any-random-secret-string-here
